# NER-RESQ Backend Configuration
PROJECT_NAME="NER-RESQ API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# CORS Allowed Origins (JSON array or comma-separated list)
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]'

# PostgreSQL + PostGIS Database Connection URL
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg2://postgres:password@localhost:5432/ner_resq"

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Server Host and Port
HOST="0.0.0.0"
PORT=8000
